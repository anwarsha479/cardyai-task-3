# Copy to .env in this folder. Values here are for local development only.

# PostgreSQL server installed on this machine (the one DBeaver connects to)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=seat_booking
DB_NAME_TEST=seat_booking_test

# Backend API
API_PORT=3040
CORS_ORIGIN=http://localhost:5176
JWT_SECRET=change-me-dev-only-secret
JWT_EXPIRES_IN=8h
# How often expired holds are marked expired and pushed to seat maps (0 turns the job off)
HOLD_SWEEP_INTERVAL_SECONDS=2

# Seed (npm run seed) - demo-only password for the seeded accounts
SEED_DEMO_PASSWORD=demo-only-password

# Frontend (Vite reads VITE_* variables from this file)
FRONTEND_PORT=5176
VITE_API_BASE_URL=http://localhost:3040/api
# Shown on the sign-in page for the seeded demo accounts; leave empty to hide the demo box
VITE_DEMO_PASSWORD=$SEED_DEMO_PASSWORD
